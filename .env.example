# ENTRE — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores

# Supabase URL (formato: https://SEU_PROJETO.supabase.co)
SUPABASE_URL=

# Supabase Anon Key (public, segura para frontend)
SUPABASE_ANON_KEY=

# Supabase Service Key (apenas para build/admin, NÃO expor no frontend)
SUPABASE_SERVICE_KEY=
